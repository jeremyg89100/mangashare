# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base de test PostgreSQL (service docker "database"). Le suffixe "_test" est
# ajouté automatiquement par config/packages/doctrine.yaml -> base "app_test".
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"

# Panther (tests d'interface) : le serveur web interne tourne en env "test",
# Chromium headless est piloté via les binaires installés dans l'image docker/php.
###> symfony/panther ###
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
PANTHER_CHROME_DRIVER_BINARY=/usr/bin/chromedriver
PANTHER_CHROME_BINARY=/usr/bin/chromium
PANTHER_NO_SANDBOX=1
###< symfony/panther ###
