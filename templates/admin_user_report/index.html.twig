{% extends 'base.html.twig' %}

{% block title %}
    Tableau Admin - Utilisateurs
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap([ 'adminBanDeleteUser', 'deleteReportUser']) }}
{% endblock %}

{% block body %}
    <div class="home-section">
        <div class="admin-tools">
            <a class="a-btn" href="{{path('app_admin')}}">Signalement</a>
            <a class="a-btn" href="{{path('app_admin_table_user')}}">Utilisateurs</a>
        </div>
        <div class="admin-user-container">
            <div class="admin-user-info">
                <span class="col-pseudo">Pseudo</span>
                <span class="col-id">ID</span>
                <span class="col-actions">Actions</span>
            </div>
            {% for user in reportedUsers %}
                <div class="admin-user-action">
                    <div class="admin-user-content">

                        <span class="col-pseudo"> {{user.pseudo}} </span>
                        <span class="col-id"> {{user.id}} </span>

                        <div class="col-actions-comment">
                            {% if user.isEnabled == true %}
                                <button class="ban-btn" data-id="{{ user.id }}" data-token="{{ csrf_token('ban') }}" type="button">Bannir</button>
                            {% else %}
                                <button class="ban-btn" data-id="{{ user.id }}" data-token="{{ csrf_token('ban') }}" type="button">Déban</button>
                            {% endif %}
                            <a href="{{ path('app_user_info', {'id' : user.id}) }}">Voir</a>
                            <button class="btn-action btn-resolve btn-erase-report-user" data-user-id="{{ user.id }}">Désignaler</button>
                        </div>
                    </div>
                    <div class="col-reason">
                            <strong>Raison :</strong> {{ user.reportReason|default('Aucune raison spécifiée') }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

