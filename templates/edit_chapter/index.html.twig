{% extends 'base.html.twig' %}

{% block title %}
    Edit Chapter
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}" >
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap([ 'app','mangaPage']) }}
{% endblock %}

{% block body %}
    {{ form_start(form, {'attr' : {'enctype' : 'multipart/form-data' } } ) }}
    <section class="home-section">
        <div class="new-project-left">
            <h1>Edite ton chapitre :</h1>
            <span class="span-color margin-bottom-span">Ajouter des pages :</span>

            <div id="upload-pages" class="upload-pages">

                {% for page in chapter.pages %}
                    <div class="new-project-middle">
                        <span class="delete-btn-pages" style="display: flex;">&times;</span>

                        <input type="file" id="file-upload-{{ loop.index }}" name="existing-pages[]" accept="image/png, image/jpeg" class="file-input">

                        <label for="file-upload-{{ loop.index }}" class="upload-file">
                            <span class="plus-icon" style="display: none;">+</span>
                            <img class="image-preview" src="{{ asset('uploads/pages/' ~ page.imageUrl) }}" alt="Page {{ page.pageOrder }}" style="display: block;">
                        </label>
                    </div>
                {% endfor %}

                <div class="new-project-middle">
                    <span class="delete-btn-pages" style="display: none">&times;</span>

                    {{ form_widget(form.pagesFiles, {
                    'id': 'file-upload',
                    'attr': {
                    'multiple': 'multiple',
                    'class': 'file-input',
                    'accept': 'image/png, image/jpeg'
                    }
                    }) }}

                    <label for="file-upload" class="upload-file">
                        <span class="plus-icon">+</span>
                        <img class="image-preview" src="" alt="Aperçu" style="display: none;">
                    </label>
                </div>
            </div>
        </div>
        <div class="new-project-right">
            <span class="span-color">Titre du chapitre :</span>
            {{ form_widget(form.title, {'value': chapter.title}) }}

            <span class="span-color">Publication :</span>
            <div class="publish-section">
                <label class="publish-btn">
                    {{ form_widget(form.published.0) }}
                    <span class="btn-text">Publié</span>
                </label>
                <label class="publish-btn">
                    {{ form_widget(form.published.1) }}
                    <span class="btn-text">Non publié</span>
                </label>
            </div>
            <div class="userpage-buttons-save">
                <button type="submit">Editer le chapitre</button>
                <button type="button" onclick="window.history.back();">Annuler</button>
            </div>
        </div>

    </section>
    {{ form_end(form) }}
{% endblock %}
