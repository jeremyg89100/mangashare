{% extends 'base.html.twig' %}

{% block title %}
    Infos Manga
{% endblock %}

{%block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{%endblock%}

{%block javascripts%}
    {{ importmap(['mangaLike']) }}
{%endblock%}

{% block body %}

    <section class="home-section">
        <div class="manga-info">
            <span class="manga-title">{{ manga.title }}</span>
            <div>
                <span class="manga-likes">
                    {{ manga.likes|length }}
                </span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
            </div>
        </div>
        <div class="manga-grid">
            <a href="#" class="manga-card">
                <div class="manga-card-cover">
                    {% if manga.miniature %}
                        <img src="{{ asset('uploads/miniatures/' ~ manga.miniature) }}" alt="{{ manga.title }}">
                    {% else %}
                        <div class="manga-card-placeholder">
                            <p> {{manga.title}} </p>
                        </div>
                    {% endif %}
                </div>
            </a>
            <div class="manga-side-info">
                <span class="manga-author">Crée par : {{ manga.user.pseudo }}</span>
                <div class="like-follow">
                    <button class="ajax-btn like-btn" data-url="{{ path('app_manga_like', { 'id' : manga.id }) }}" data-csrf="{{ csrf_token('like')}}">J'aime</button>
                    {# <button class="ajax-btn" data-url="{{ path('app_manga_follow', { 'id' : user.id }) }}">Suivre {{manga.user.pseudo}}</button> #}
                </div>
                <span>Synopsis : </span>
                <span class="manga-synopsis margin-top-class">{{manga.synopsis|raw}}</span>
            </div>

        </div>
        <div class="edit-btn">
            <a href="{{path('app_read_manga', {'mangaId' : manga.id, 'chapterId' : manga.chapters.first.id })}}">Lire</a>
            <button type="button">Commentaire</button>
        </div>
        <h3 class="margin-top-class">Chapitres : </h3>
        {% for chapter in manga.chapters %}
            <a href="{{ path('app_read_manga', {'mangaId': manga.id,'chapterId': chapter.id }) }}" class="chapter-card margin-top-class">
                <span> {{chapter.title}} </span>
                <span>#{{loop.index}}</span>
            </a>
        {% endfor %}
        <h3 class="margin-top-class">Autres projets de {{user.pseudo}}</h3>
        {% for m in user.mangas %}
            {% if m.id != manga.id %}
                <div class="project-card">
                    <div class="project-card-cover">
                        <div class="manga-grid">
                            <a href="#" class="manga-card">
                                <div class="manga-card-cover">
                                    {% if m.miniature %}
                                        <img src="{{ asset('uploads/miniatures/' ~ manga.miniature) }}" alt="{{ manga.title }}">
                                    {% else %}
                                        <div class="manga-card-placeholder">
                                            <p> {{m.title}} </p>
                                        </div>
                                    {% endif %}
                                </div>
                            </a>
                        </div>
                    </div>

                    <div class="side-manga-info">
                        <span> {{m.title}} </span>
                        <span> {{m.status}} </span>
                        {%for category in m.categories%}
                            <span class="chip"> {{category}} </span>
                        {%endfor%}
                    </div>
                </div>
            {% endif %}
        {%endfor%}
        {%if manga.comments%}
            {% for comment in manga.comments %}
                <div class="manga-comment">
                    <span>{{comment.user.miniature}}</span>
                    <span>{{comment.user.pseudo}}</span>
                    <span>{{comment.createdAt|date('d/m/Y')}}</span>
                    <span> {{comment.content}} </span>
                </div>
            {%endfor%}
        {%endif%}
    </section>

{% endblock %}
