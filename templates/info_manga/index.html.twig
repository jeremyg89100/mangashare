{% extends 'base.html.twig' %}

{% block title %}
    Infos Manga
{% endblock %}

{%block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{%endblock%}

{%block javascripts%}
    {{ parent() }}
    {{ importmap(['mangaLike', 'userFollow', 'comment', 'report', 'deleteComment']) }}
{%endblock%}

{% block body %}

    <section class="home-section">
        <div class="manga-info">
            <span class="manga-title">{{ manga.title }}</span>
            <div>
                <span class="manga-likes">
                    {{ manga.likes|length }}
                </span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
            </div>
        </div>

        {# 🎯 Grille alignant uniquement l'image et le bloc d'infos #}
        <div class="info-manga-grid">
            <a href="{{path('app_info_manga', {'id' : manga.id })}}" class="manga-card">
                <div class="info-manga-card-cover">
                    {% if manga.miniature %}
                        <img src="{{ asset('uploads/miniatures/' ~ manga.miniature) }}" alt="{{ manga.title }}">
                    {% else %}
                        <div class="manga-card-placeholder">
                            <p> {{manga.title}} </p>
                        </div>
                    {% endif %}
                </div>
            </a>

            <div class="manga-side-info">
                <a href="{{path('app_user_info', {'id' : manga.user.id }) }}">
                    <span class="manga-author">Crée par : {{ manga.user.pseudo }}</span>
                </a>
                <div class="like-follow">
                    <button class="ajax-btn like-btn margin-top-class" data-url="{{ path('app_manga_like', { 'id' : manga.id }) }}" data-csrf="{{ csrf_token('like')}}">
                        {%if manga.isLikedByUser(app.user)%}
                            Je n'aime plus
                        {%else%}
                            J'aime
                        {%endif%}
                    </button>
                    <button class="ajax-btn follow-btn margin-top-class" data-pseudo="{{manga.user.pseudo}}" data-url="{{ path('app_user_follow', { 'id' : manga.user.id }) }}" data-csrf="{{ csrf_token('follow')}}">
                        {%if manga.user.isFollowedBy(app.user)%}
                            Ne plus suivre
                        {%else%}
                            Suivre {{manga.user.pseudo}}
                        {%endif%}
                    </button>
                </div>
                <div class="synopsis-block">
                    <span>Synopsis : </span>
                    <span class="manga-synopsis margin-top-class">{{manga.synopsis|sanitize_html}}</span>
                </div>
            </div>
        </div> {# 👈 FIX : Fermeture de la div .manga-grid ici pour séparer le haut du bas ! #}

        {# 🎯 Ce bloc se placera maintenant parfaitement en dessous sur toute la largeur #}
        <div class="container-info-manga">
            <div class="edit-btn">
                <a href="{{path('app_read_manga', {'mangaId' : manga.id, 'chapterId' : manga.chapters.first.id })}}">Lire</a>
                <button class="comment-btn" type="button">Commentaire</button>
            </div>

            <form class="form-comment" action="{{path('app_manga_comment', {'id' : manga.id})}}"
                method="POST" data-miniature="{{app.user.avatar}}" data-user-pseudo="{{app.user.pseudo}}"
                data-comment-id="comment.id" enctype="multipart/form-data"></form>

                <h3 class="margin-top-class">Chapitres : </h3>
                {% for chapter in manga.chapters %}
                    <a href="{{ path('app_read_manga', {'mangaId': manga.id,'chapterId': chapter.id }) }}" class="chapter-card margin-top-class">
                        <span> {{chapter.title}} </span>
                        <span>#{{loop.index}}</span>
                    </a>
                {% endfor %}

                <div class="comment-list">
                    {%if manga.comments%}
                        {% for comment in manga.comments %}
                            <div class="manga-comment">
                                <div class="comment-info">
                                    <div class="comment-name-avatar">
                                        <div class="nav-avatar">
                                            {% if comment.user.avatar %}
                                                <img src="{{ asset('uploads/miniatures/' ~ comment.user.avatar) }}" alt="Avatar">
                                            {% else %}
                                                {{ comment.user.pseudo|slice(0,1)|upper }}
                                            {% endif %}
                                        </div>
                                        <span class="comment-user-pseudo">{{ comment.user.pseudo }}</span>
                                    </div>
                                    <div class="date-signal-btn">
                                        <span class="comment-date">{{ comment.createdAt|date('d/m/Y') }}</span>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <button type="button" class="btn btn-sm btn-report signal-btn btn-delete-comment" data-comment-id="{{ comment.id }} ">Supprimer</button>
                                        {% elseif is_granted('ROLE_USER') %}
                                            <button type="button" class="btn btn-sm btn-report signal-btn btn-confirm-report btn-comment-report" data-comment-id="{{ comment.id }} ">Signaler</button>
                                            <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Signaler ce commentaire ?</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Êtes-vous sûr de vouloir signaler ce commentaire à l'équipe de modération ?
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light text-dark" data-bs-dismiss="modal">Annuler</button>
                                                            <button type="button" class="btn btn-danger text-white" id="confirmReportBtn">Confirmer le signalement</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="comment-content">
                                    <span>{{ comment.textContent }}</span>
                                </div>
                            </div>
                        {%endfor%}
                    {%endif%}
                </div>
            </div>
        </section>

    {% endblock %}
