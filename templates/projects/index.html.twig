{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}" >
{% endblock %}

{% block title %}
    Projects
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap(['deleteManga']) }}
{% endblock %}

{% block body %}
    <section class="home-section">
        <div class="project-header project-buttons">
            <h1 class="project-header-title">Partage tes projets avec la communauté !</h1>
            <a class="add-project-button" href="{{ path('app_new_project') }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: middle;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Ajouter un nouveau projet
            </a>
        </div>

        <div class="project-section">
            <h3>Vos Projets</h3>

            <div class="projects-grid margin-top-class">
                {% for manga in user.mangas %}
                    <div class="project-card">
                        <div class="project-card-cover">
                            {% if manga.miniature %}
                                <img src="{{ asset('uploads/miniatures/' ~ manga.miniature) }}" alt="{{ manga.title }}">
                            {% else %}
                                <div class="project-card-placeholder">
                                    <p> {{manga.title}} </p>
                                </div>
                            {% endif %}
                        </div>
                        <div class="project-side-info">
                            <span> {{manga.title}} </span>
                            <div class="project-buttons-end">
                                <a class="btn-action btn-edit" href="{{ path('app_edit_manga', {'id' : manga.id}) }}">Editer</a>

                                <form action="{{ path('app_delete_manga', {'id': manga.id}) }}" method="POST">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ manga.id) }}">
                                    <button class="btn-action btn-delete btn-erase-manga" data-manga-id="{{ manga.id }}" type="button">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
