{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}" >
{% endblock %}

{% block title %}
    Projects
{% endblock %}

{% block body %}
    <section class="home-section">
        <div class="project-header project-buttons">
            <h1>Partages tes projets avec la communauté !</h1>
            <a class="add-project-button" href="{{path('app_new_project')}}">Ajouter un nouveau projet</a>
        </div>
        <div class="project-section">
            <h3>Your Projects</h3>
            {% for manga in user.mangas %}
                <div class="project-card">
                    <div class="project-card-cover">
                        {% if manga.miniature %}
                            <img src="{{ asset('uploads/' ~ manga.miniature) }}" alt="{{ manga.title }}">
                        {% else %}
                            <div class="project-card-placeholder">
                                <p> {{manga.title}} </p>
                            </div>
                        {% endif %}
                    </div>
                    <div class="project-side-info">
                        <span> {{manga.title}} </span>
                        <div class="project-buttons">
                            <button>Editer</button>
                            <button>Supprimer</button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
