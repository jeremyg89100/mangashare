<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}MangaShare{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>
    <body>

        {# Checkbox Hamburger #}
        <input type="checkbox" id="hamburger-toggle" class="hamburger-checkbox">

        {# Checkbox hamburger Dropdown #}
        <input type="checkbox" id="user-toggle" class="user-checkbox">
        <nav>
            <a href="{{ path('app_home') }}" class="nav-logo">MangaShare</a>

            <div class="nav-links">
                <a href="#">Nouveautés</a>
                <a href="#">Projets</a>
                <a href="#">Populaire</a>
                <a href="#">Astuces</a>
                <a href="#">Règles</a>
            </div>

            <div class="nav-mobile-search">
                <input type="text" placeholder="Rechercher…" autocomplete="off">
            </div>

            <div class="nav-right-part">
                <div class="nav-actions">
                    {% if app.user %}
                        <div class="nav-bell">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                            </svg>
                        </div>
                        <div class="nav-user">
                            <div class="nav-avatar" id="avatar-btn">
                                {% if app.user.avatar %}
                                    <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Avatar">
                                {% else %}
                                    {{ app.user.pseudo|slice(0,1)|upper }}
                                {% endif %}
                            </div>
                            <div class="nav-dropdown-menu" id="user-dropdown">
                                <a href="#">Mon profil</a>
                                <a href="#">Mes Projets</a>
                                <a href="#">Mes Astuces</a>
                                <a href="#">Dashboard</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="#">Administration</a>
                                {% endif %}
                                <a href="{{ path('app_logout') }}" class="nav-logout">Déconnexion</a>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="nav-login-btn">Connexion</a>
                    {% endif %}

                    <label for="hamburger-toggle" class="nav-hamburger" aria-label="Menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </label>

                </div>
            </div>
        </nav>

        {# Mobile Menu #}
        <div class="nav-mobile-menu">
            <a href="{{ path('app_home') }}">Nouveautés</a>
            <a href="#">Projets</a>
            <a href="#">Populaire</a>
            <a href="#">Astuces</a>
            <a href="#">Règles</a>
        </div>

        <main>
            {% block body %}
            {% endblock %}
        </main>

        <footer>
            <div class="footer-content">
                <p class="footer-logo">MangaShare</p>
                <div class="footer-follow">
                    <p>Nous suivre</p>
                    <div class="footer-socials">
                        <a href="#" aria-label="Instagram">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                            </svg>
                        </a>
                        <a href="#" aria-label="Twitter/X">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4l16 16M4 20L20 4"/>
                            </svg>
                        </a>
                        <a href="#" aria-label="Discord">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.054a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© {{ "now"|date("Y") }} MangaShare — Tous droits réservés</p>
            </div>
        </footer>
        <script>
            const avatar = document.getElementById('avatar-btn');
            const dropdown = document.getElementById('user-dropdown');

            if (avatar) {
                avatar.addEventListener('click', (e) => {
                    e.stopPropagation();
                    dropdown.classList.toggle('open');
                });
                document.addEventListener('click', () => {
                    dropdown.classList.remove('open');
                });
            }
        </script>
    </body>
</html>
