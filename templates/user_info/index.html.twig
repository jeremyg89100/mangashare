{% extends 'base.html.twig' %}

{% block title %}
    Infos Utilisateur
{% endblock %}

{%block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{%endblock%}

{%block javascripts%}
    {{ parent() }}
    {{ importmap(['mangaLike', 'userFollow', 'comment', 'reportUser']) }}
{%endblock%}

{% block body %}
    <section class="home-section">
        <div class="manga-side-info">
            <div class="user-follow">
                <span class="userName margin-top-class margin-bottom-class"> {{ user.pseudo }}</span>
                <button class="ajax-btn follow-btn margin-top-class margin-bottom-class" data-pseudo="{{user.pseudo}}" data-url="{{ path('app_user_follow', { 'id' : user.id }) }}" data-csrf="{{ csrf_token('follow')}}">
                    {%if user.isFollowedBy(app.user)%}
                        Ne plus suivre
                    {%else%}
                        Suivre {{user.pseudo}}
                    {%endif%}
                </button>
                {% if is_granted('ROLE_USER') %}
                    <button type="button" class="btn btn-sm btn-report signal-btn btn-confirm-report btn-user-report" data-user-id="{{ user.id }}">Signaler</button>
                    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Signaler cet utilisateur ?</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <textarea id="reportReason" class="form-control" rows="3" placeholder="Pour quelle raison voulez-vous signaler cette utilisateur ?"></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light text-dark" data-bs-dismiss="modal">Annuler</button>
                                    <button type="button" class="btn btn-danger text-white" id="confirmReportBtn">Confirmer le signalement</button>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <h3 class="margin-top-class margin-bottom-class">Mangas de {{user.pseudo}}</h3>
        {% for manga in user.mangas %}
            <div class="project-card">

                <a href="{{path('app_info_manga', {'id' : manga.id }) }}" class="manga-card">
                    <div class="manga-card-cover">
                        {% if manga.miniature %}
                            <img src="{{ asset('uploads/miniatures/' ~ manga.miniature) }}" alt="{{ manga.title }}">
                        {% else %}
                            <div class="manga-card-placeholder">
                                <p> {{ manga.title }} </p>
                            </div>
                        {% endif %}
                    </div>
                </a>

                <div class="side-manga-info">
                    <span> {{ manga.title }} </span>
                    <span> {{ manga.status }} </span>
                    {% for category in manga.categories %}
                        <span class="chip"> {{ category }} </span>
                    {% endfor %}
                </div>

            </div>
        {% endfor %}

        <h3 class="margin-top-class margin-bottom-class">Articles de {{user.pseudo}}</h3>
        {% for article in user.articles %}
            <div class="project-card">
                <a href="{{ path('app_read_article' , {'id' : article.id }) }}" class="manga-card">
                    <div class="manga-card-cover">
                        {% if article.miniature %}
                            <img src="{{ asset('uploads/miniatureArticle/' ~ article.miniature) }}" alt="{{ article.title }}">
                        {% else %}
                            <div class="manga-card-placeholder">
                                <p> {{article.title}} </p>
                            </div>
                        {% endif %}
                    </div>
                </a>


                <div class="side-manga-info">
                    <span> {{article.title}} </span>
                    <span class="chip"> {{article.category}} </span>
                </div>
            </div>
        {%endfor%}
    </section>
{% endblock %}
