{% extends 'base.html.twig' %}

{% block title %}
    Manga Edit
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}" >
{% endblock %}

{% block body %}
    <section class="home-section">
        <div class="project-header project-buttons">
            <h1>Edites ou ajoute un chapître à ton projet !</h1>
            <a class="add-project-button" href="{{path('app_new_project')}}">Ajouter un nouveau chapitre</a>
        </div>

        <div class="chapter-section">
            <h2>Vos chapîtres</h2>
            {% for chapter in manga.chapters %}
                <div class="chapter-title">
                    <div class="chapter-text-group">
                        <span>Chapitre {{chapter.number}} :</span>
                        <h3>{{chapter.title}}</h3>
                    </div>

                    <div class="chapter-publish">
                        {% if chapter.published == 1 %}
                            <span>Publié</span>
                        {% else %}
                            <span>Non publié</span>
                        {% endif %}
                    </div>
                </div>
                <div class="chapter-btn">
                    <a href="{{path('app_edit_chapter', {'id' : chapter.id })}}">Editer</a>
                    <button>Supprimer</button>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
