{% extends 'base.html.twig' %}

{% block title %}
    Utilisateurs suivis
{% endblock %}

{% block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{% endblock%}

{% block javascripts %}
    {{ parent() }}
    {{ importmap(['unfollow']) }}
{% endblock %}

{% block body %}
    <section class="home-section">
        <h3 class="margin-top-class">Utilisateurs suivis : </h3>
        {% for follow in follows %}
            <div class="following-card">
                <div class="following-avatar-pseudo">
                    <div class="nav-avatar">
                        {% if follow.following.avatar %}
                            <img src="{{ asset('uploads/miniatures/' ~ follow.following.avatar) }}" alt="Avatar">
                        {% else %}
                            {{ follow.following.pseudo|slice(0,1)|upper }}
                        {% endif %}
                    </div>
                    <span>{{ follow.following.pseudo }}</span>
                </div>
                <button class="ajax-btn unfollow-btn margin-top-class margin-bottom-class" data-pseudo="{{follow.following.pseudo}}" data-url="{{ path('app_user_unfollow', { 'id' : follow.following.id }) }}" data-csrf="{{ csrf_token('unfollow')}}">
                Se désabonner
                </button>
            </div>
        {% else %}
            <p>Vous ne suivez aucun utilisateur pour le moment.</p>
        {% endfor %}
    </section>
{% endblock %}
