{% extends 'base.html.twig' %}

{% block title %}
    UserPage
{% endblock %}

{% block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{% endblock%}

{% block javascripts %}
    {{ importmap([ 'mangaPage']) }}
{% endblock %}

{% block body %}
    <form action="{{path('app_user_page')}}" method="POST" enctype="multipart/form-data">
        <div class="home-section">
            <div class="userpage-section">
                <div class="userpage-top-buttons">
                    <a>Compte</a>
                    <a>Dashboard</a>
                </div>
                <div class="userpage-pseudo-avatar">
                    <div class="pseudo-userpage">
                        <label>Pseudo</label>
                        <input type="text" id="pseudo" name="pseudo" value="{{user.pseudo}}" placeholder="pseudo">
                    </div>
                    <div class="avatar-profil-30px">
                        <input type="file" id="file-avatar" name="avatar" accept="image/png, image/jpeg" class="file-input-avatar" style="display: none;">

                        <label for="file-avatar" class="avatar-click-zone">
                            {% if app.user.avatar %}
                                <img class="image-preview" src="{{ asset('uploads/avatar/' ~ app.user.avatar) }}" alt="Aperçu">
                            {% else %}
                                <span class="avatar-letter avatar-placeholder">
                                    {{ app.user.pseudo|slice(0,1)|upper }}
                                </span>
                                <img class="image-preview" src="" alt="Aperçu" style="display: none;">
                            {% endif %}
                        </label>
                    </div>
                </div>

                <label>E-mail</label>
                <input type="text" id="email" name="email" value="{{user.email}}">
                <label>Date de naissance</label>
                <input type="date" id="birthdate" name="birthdate" value="{{user.birthdate ? user.birthdate|date('Y-m-d') : ''}}">
                <label>Description (optionnelle)</label>
                <input type="text" id="description" name="description" value="{{user.description}}">
                <label>Changement de mot de passe</label>
                <input type="text" id="changePassword" name="changePassword" placeholder="mot de passe">
                <label>Confirmation du mot de passe</label>
                <input type="text" id="passwordConfirm" name="passwordConfirm" placeholder="mot de passe">
                <div class="userpage-buttons-save">
                    <button type="submit">Sauvegarder</button>
                    <button type="button" onclick="window.history.back();">Annuler</button>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
