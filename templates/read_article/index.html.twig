{% extends 'base.html.twig' %}

{% block title %}
    Lire Article
{% endblock %}

{%block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{%endblock%}

{%block javascripts%}
    {{ parent() }}
    {{ importmap(['mangaLike', 'userFollow', 'comment', 'deleteComment']) }}
{%endblock%}

{% block body %}
    <div class="home-section">
        <div class="read-article-top">
            <h3> {{article.user.pseudo}} </h3>
            <div class="like-follow">
                <button class="ajax-btn like-btn" data-url="{{ path('app_article_like', { 'id' : article.id }) }}" data-csrf="{{ csrf_token('like')}}">
                    {%if article.isLikedByUser(app.user)%}
                        Je n'aime plus
                    {%else%}
                        J'aime
                    {%endif%}
                </button>
                <button class="ajax-btn follow-btn" data-pseudo="{{article.user.pseudo}}" data-url="{{ path('app_user_follow', { 'id' : article.user.id }) }}" data-csrf="{{ csrf_token('follow')}}">
                    {%if article.user.isFollowedBy(app.user)%}
                        Ne plus suivre
                    {%else%}
                        Suivre {{article.user.pseudo}}
                    {%endif%}
                </button>
            </div>
        </div>
        <span class="read-article-content margin-top-class">{{article.textContent|sanitize_html}}</span>
        <div class="edit-btn">
            <button class="comment-btn" type="button">Commentaire</button>
        </div>
        <form class="form-comment"
            method="POST"
            action="{{ path('app_article_comment', {'id': article.id}) }}"
            data-user-pseudo="{{ app.user ? app.user.pseudo : 'Anonyme' }}"
            data-miniature="{{ app.user ? app.user.avatar : '' }}">
        </form>

        <div class="comment-list">
            {% if article.comments %}
                {% for comment in article.comments %}
                    <div class="manga-comment">
                        <div class="comment-info">
                            <div class="comment-name-avatar">
                                <div class="nav-avatar">
                                    {% if comment.user.avatar %}
                                        <img src="{{ asset('uploads/miniatures/' ~ comment.user.avatar) }}" alt="Avatar">
                                    {% else %}
                                        {{ comment.user.pseudo|slice(0,1)|upper }}
                                    {% endif %}
                                </div>
                                <span class="comment-user-pseudo">{{ comment.user.pseudo }}</span>
                            </div>
                            <div class="date-signal-btn">
                                <span class="comment-date">{{ comment.createdAt|date('d/m/Y') }}</span>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <button type="button" class="btn btn-sm btn-report signal-btn btn-delete-comment" data-comment-id="{{ comment.id }} ">Supprimer</button>
                                {% elseif is_granted('ROLE_USER') %}
                                    <button type="button" class="btn btn-sm btn-report signal-btn btn-confirm-report btn-comment-report" data-comment-id="{{ comment.id }} ">Signaler</button>
                                    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Signaler ce commentaire ?</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Êtes-vous sûr de vouloir signaler ce commentaire à l'équipe de modération ?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light text-dark" data-bs-dismiss="modal">Annuler</button>
                                                    <button type="button" class="btn btn-danger text-white" id="confirmReportBtn">Confirmer le signalement</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="comment-content">
                            <span>{{ comment.textContent }}</span>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}
