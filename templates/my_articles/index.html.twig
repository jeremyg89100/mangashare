{% extends 'base.html.twig' %}

{% block title %}
    Mes Articles
{% endblock %}

{% block stylesheets%}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}">
{%endblock%}

{% block body %}
    <section class="home-section">
        <div class="project-header project-buttons">
            <h1>Partages tes astuces avec la communauté !</h1>
            <a href="{{path('app_new_article')}}" class="add-project-button">Ecris un article</a>
        </div>
        <div class="project-section">
            <h3>Articles</h3>
            <div class="filter">
                <a href="{{ path('app_my_articles')}}" class="chip {{ currentCategory is null ? 'active' }}">Tout</a>
                {% for cat in categories %}
                    <a href="{{ path('app_articles', {'category' : cat}) }}"
                        class="chip {{currentCategory == cat ? 'active'}}"> {{ cat }}
                        </a>
                    {% endfor %}
                </div>
                <section class="articles-section">
                    {% for article in articles %}
                        <div class="article-card">
                            <div class="article-card-left">
                                <div class="article-img">
                                    {% if article.miniature %}
                                        <img src="{{ asset('uploads/miniatureArticle/' ~ article.miniature) }}" alt="{{ article.title }}">
                                    {% else %}
                                        <div class="project-card-placeholder">
                                            <p> {{article.title}} </p>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="article-infos">
                                    <span> {{article.user.pseudo}} </span>
                                    <span class="article-likes">
                                        {{ article.likes|length }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                        </svg>
                                    </span>
                                </div>
                            </div>
                            <div class="article-card-right">
                                <div class="article-content">
                                    <h3> {{article.title}} </h3>
                                    <p> {{article.textContent|raw}} </p>
                                </div>
                                <div class="edit-btn">
                                    <a href=" {{path('app_edit_articles', {'id' : article.id }) }} "> Editer </a>
                                    <button type="button">Supprimer</button>
                                </div>
                            </div>
                        </div>
                    {%endfor%}
                </section>
            </div>
        </section>
    {% endblock %}
