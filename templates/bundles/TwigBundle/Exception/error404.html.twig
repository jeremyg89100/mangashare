{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('styles/home.css')}}" >
{% endblock %}

{% block body %}
    <section class="home-section" style="text-align: center; padding: 50px;">
        <h1 class="margin-bottom-class">Oups ! Cette page n'existe pas.</h1>
        <p class="margin-bottom-class">Le manga ou le chapitre que vous cherchez a peut-être été déplacé ou supprimé.</p>
        <div>
            <a href="{{ path('app_home') }}" class="btn-text" style="background: black; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none;">
                Retourner à l'accueil
            </a>
        </div>
    </section>
{% endblock %}
